  "tracks": [
    {
      "track": 1,
      "method": "clause-pause-estimate",
      "secondsPerVoicedSyllable": 0.22109375,
      "segments": [
        {
          "text": "阮兜的糖霜丸",
          "start": 1.52,
          "end": 3.66
        },
        {
          "text": "巫素宜",
          "start": 3.66,
          "end": 5.48
        },
        {
          "text": "前一站仔我定定感覺心肝頭鬱鬱，",
          "start": 5.48,
          "end": 10.08
        },
        {
          "text": "規个人無攬無拈，",
          "start": 10.08,
          "end": 12.71
        },
        {
          "text": "對逐項代誌攏無興頭。",
          "start": 12.71,
          "end": 15.78
        },
        {
          "text": "阿母看我按呢，",
          "start": 15.78,
          "end": 17.75
        },
        {
          "text": "提議講：",
          "start": 17.75,
          "end": 19.03
        },
        {
          "text": "「咱來飼一隻動物伴，好無？」",
          "start": 19.03,
          "end": 22.07
        },
        {
          "text": "我目睭隨金起來，",
          "start": 22.07,
          "end": 24.3
        },
        {
          "text": "因為我想欲飼一隻貓仔已經想足久的矣！",
          "start": 24.3,
          "end": 29.0
        },
        {
          "text": "我佮阿兄隨佇網路面頂搜揣領養貓仔的消息，",
          "start": 29.0,
          "end": 35.19
        },
        {
          "text": "用領養代替用買的，",
          "start": 35.19,
          "end": 37.96
        },
        {
          "text": "嘛算是做好代。",
          "start": 37.96,
          "end": 40.22
        },
        {
          "text": "無兩工的時間，",
          "start": 40.22,
          "end": 42.35
        },
        {
          "text": "就揣著佮阮有緣的「阿奇」。",
          "start": 42.35,
          "end": 45.53
        },
        {
          "text": "伊是一隻三個外月的貓公，",
          "start": 45.53,
          "end": 49.06
        },
        {
          "text": "有柑仔色的花草，",
          "start": 49.06,
          "end": 51.33
        },
        {
          "text": "看著有成一隻細隻虎。",
          "start": 51.33,
          "end": 54.55
        },
        {
          "text": "阿爸佮阿母講希望伊會當消敨我心內的憂愁，",
          "start": 54.55,
          "end": 62.55
        },
        {
          "text": "就共號做「去憂」；",
          "start": 62.55,
          "end": 65.44
        },
        {
          "text": "阿兄叫伊「來福」，",
          "start": 65.44,
          "end": 68.13
        },
        {
          "text": "向望伊來阮兜了後，",
          "start": 68.13,
          "end": 70.8
        },
        {
          "text": "福氣綴咧來；",
          "start": 70.8,
          "end": 72.76
        },
        {
          "text": "我叫伊「阿奇」，",
          "start": 72.76,
          "end": 74.8
        },
        {
          "text": "因為伊今仔來厝裡的時，",
          "start": 74.8,
          "end": 77.61
        },
        {
          "text": "一直四界看，",
          "start": 77.61,
          "end": 79.41
        },
        {
          "text": "逐項物件攏足有興趣，",
          "start": 79.41,
          "end": 82.19
        },
        {
          "text": "遮看一下，",
          "start": 82.19,
          "end": 83.7
        },
        {
          "text": "遐鼻一下。",
          "start": 83.7,
          "end": 85.26
        },
        {
          "text": "一睏頭有三个名，",
          "start": 85.26,
          "end": 87.61
        },
        {
          "text": "毋知伊敢會聽甲花嗄嗄？",
          "start": 87.61,
          "end": 90.46
        }
      ],
      "sentences": [
        {
          "id": "tang-p1-s1",
